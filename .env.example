# Copiez ce fichier en .env et renseignez les valeurs de votre projet Supabase
# (Project Settings → API). Sans ces deux lignes, l'application démarre en mode démonstration.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Facultatif : base des liens courts (ex. https://formation.samsa.fr/). Par défaut, l'adresse du site.
# VITE_SHORT_BASE=
